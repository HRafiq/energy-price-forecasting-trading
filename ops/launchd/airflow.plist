<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: `make launchd-install` fills in the repository path and PATH. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.energy-price-forecasting.airflow</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/make</string>
    <string>-C</string>
    <string>@REPO@</string>
    <string>airflow</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>@REPO@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>@REPO@/airflow_home/logs/launchd-airflow.log</string>
  <key>StandardErrorPath</key>
  <string>@REPO@/airflow_home/logs/launchd-airflow.log</string>
</dict>
</plist>
