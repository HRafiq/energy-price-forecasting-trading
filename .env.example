# Copy this file to .env and fill in what you have. .env is gitignored: never commit
# it, and never put a real key in this file.

# ENTSO-E Transparency Platform token, for the price cross-check and German
# imbalance prices (make entsoe). The README explains how to request access.
ENTSOE_API_KEY=

# The desk briefing. By default it is written from the page's own numbers by a
# deterministic writer, and no key is needed. To have a model write it instead, set
# NARRATION_PROVIDER to openai or anthropic and that provider's key; a key alone
# does not switch the model on. Every figure the model writes is checked against
# the page, but not the meaning it gives a figure, which is why it is off by
# default (docs/production_notes.md, M5).
NARRATION_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: a model name overriding the default, gpt-4o-mini for OpenAI or
# claude-haiku-4-5-20251001 for Anthropic.
NARRATION_MODEL=
