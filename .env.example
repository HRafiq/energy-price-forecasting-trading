# Copy this file to .env and fill in what you have. .env is gitignored: never commit
# it, and never put a real key in this file.

# ENTSO-E Transparency Platform token, for the price cross-check and German
# imbalance prices (make entsoe). The README explains how to request access.
ENTSOE_API_KEY=

# The desk briefing. With no key it is written from the page's own numbers by a
# deterministic writer. Set a key to have a model write it; every figure the model
# writes is still checked against the page before it is shown.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. With both keys set, openai or anthropic chooses which one answers
# (OpenAI otherwise), and a model name overrides the default: gpt-4o-mini for
# OpenAI, claude-haiku-4-5-20251001 for Anthropic.
NARRATION_PROVIDER=
NARRATION_MODEL=
